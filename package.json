{
  "name": "word-atlas",
  "version": "1.0.0",
  "type": "module",
  "description": "Атлас английских слов для IELTS: 7298 слов с русскими переводами, иллюстрациями, аудио и интервальным повторением FSRS.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/**/*.test.ts && python3 scripts/package_public.py --self-test",
    "check:atlas": "node scripts/check-atlas.mjs",
    "check:ui": "node scripts/check-russian-ui.mjs",
    "build:atlas": "python3 scripts/atlas/build_ru.py",
    "render:cards": "node scripts/render-cards.mjs",
    "pack:public": "python3 scripts/package_public.py --out /tmp/word-atlas-public",
    "format": "prettier --write src vite.config.ts scripts/*.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "private": true,
  "license": "MIT"
}
